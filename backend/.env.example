APP_NAME=Karatarkhis CRM API
APP_ENV=development
APP_VERSION=5.0.0-dev
DATABASE_URL=postgresql+psycopg://karatarkhis:change-me@localhost:5432/karatarkhis
LOG_LEVEL=INFO

# Google integration. Never commit real credentials.
GOOGLE_SPREADSHEET_ID=
# Preferred on Vercel: base64 of the entire service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# Alternative for environments that safely support raw multiline JSON secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local/server alternative using a mounted secret file.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_CUSTOMER_DOCS_ROOT_FOLDER_ID=
GOOGLE_CASE_IMPORT_ROOT_FOLDER_ID=
GOOGLE_CASE_EXPORT_ROOT_FOLDER_ID=

# Telegram integration - secrets stay outside Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
