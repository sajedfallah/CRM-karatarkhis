{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "outputDirectory": "app/web/panel",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,tests/**,__pycache__/**}"
    }
  },
  "routes": [
    {
      "src": "/app(?:/(.*))?",
      "dest": "/api/index",
      "transforms": [{"type":"request.path","op":"set","args":"/app/$1"}]
    },
    {
      "src": "/(activate|login|account|auth-assets/.*)",
      "dest": "/api/index",
      "transforms": [{"type": "request.path", "op": "set", "args": "/$1"}]
    },
    {
      "src": "/",
      "dest": "/api/index",
      "transforms": [{"type": "request.path", "op": "set", "args": "/"}]
    },
    {
      "src": "/health",
      "dest": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/health"
        }
      ]
    },
    {
      "src": "/health/db",
      "dest": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/health/db"
        }
      ]
    },
    {
      "src": "/health/sheets",
      "dest": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/health/sheets"
        }
      ]
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/v1/$1"
        }
      ]
    },
    {
      "src": "/docs",
      "dest": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/docs"
        }
      ]
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/openapi.json"
        }
      ]
    }
  ]
}
